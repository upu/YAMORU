{
	// YAMORUのCloudflare Workers / D1ローカル開発設定。
	// リモートdatabase_idと本番デプロイ設定はIssue #123で確定する。
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "yamoru",
	"compatibility_date": "2026-08-19",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// database_id はローカル開発では未使用(--local実行時はwrangler側で無視される)。
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "yamoru-local",
			"database_id": "local-only-placeholder",
			"migrations_dir": "d1/migrations"
		}
	],
	"env": {
		"e2e": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "yamoru-e2e-local",
					"database_id": "e2e-local-only-placeholder",
					"migrations_dir": "d1/migrations"
				}
			]
		}
	}
}
