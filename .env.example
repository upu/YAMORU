NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# サーバー専用(NEXT_PUBLIC_を付けない)。招待の交換・受諾RPC(Issue #70)を
# service_role経由でのみ呼ぶために使う。ブラウザへ公開してはいけない。
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# LAN内の別端末などから開発サーバーへ接続する場合に、起動マシンのIPv4アドレスを指定します。
# 同じ値がHTTPS開発証明書の対象ホストにもなるため、変更後は`npm run dev:cert`で再生成してください。
YAMORU_ALLOWED_DEV_ORIGINS=192.168.1.10
