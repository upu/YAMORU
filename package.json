{
  "name": "yamoru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev-https-cert.ts && next dev --experimental-https --experimental-https-key ./.certs/dev/key.pem --experimental-https-cert ./.certs/dev/cert.pem",
    "dev:cert": "node --env-file-if-exists=.env.local scripts/dev-https-cert.ts",
    "dev:http": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "test": "vitest run",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:local": "npm run d1:migrate:e2e && playwright test",
    "test:e2e:preview": "playwright test -c config/playwright.preview.config.ts",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && wrangler dev",
    "cf:config:check": "node scripts/cloudflare.ts check",
    "cf:deploy:preview": "node scripts/cloudflare.ts deploy preview",
    "cf:deploy:production": "node scripts/cloudflare.ts deploy production",
    "cf:smoke": "node scripts/cloudflare-smoke.ts",
    "d1:migrate": "node --env-file=scripts/d1-test.env ./node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --local",
    "d1:migrate:e2e": "node --env-file=scripts/d1-test.env ./node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --local --env e2e",
    "d1:migrate:preview": "node scripts/cloudflare.ts migrate preview",
    "d1:migrate:production": "node scripts/cloudflare.ts migrate production",
    "test:d1": "node --env-file=scripts/d1-test.env ./node_modules/vitest/vitest.mjs run --config config/vitest.d1.config.ts",
    "auth:bootstrap": "node scripts/auth-admin.ts bootstrap",
    "auth:bootstrap:preview": "node scripts/auth-admin.ts bootstrap --environment preview",
    "auth:bootstrap:production": "node scripts/auth-admin.ts bootstrap --environment production",
    "auth:reset-password": "node scripts/auth-admin.ts reset-password",
    "auth:reset-password:preview": "node scripts/auth-admin.ts reset-password --environment preview",
    "auth:reset-password:production": "node scripts/auth-admin.ts reset-password --environment production"
  },
  "dependencies": {
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "wrangler": "^4.124.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260815.1": true,
    "esbuild@0.28.2": true
  }
}
