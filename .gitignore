# Dependencies and build outputs
node_modules/
.next/
out/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Next.js generated type reference file
next-env.d.ts

# Local environment variables
.env
.env.*
!.env.example

# Local HTTPS development certificate and key (mkcert)
.certs/

# Local Supabase prod/test environments (Issue #31): config.toml is
# hand-authored and tracked, but migrations/seed.sql/tests are derived
# copies of supabase/ written by scripts/supabase-env-sync.ts, and
# .branches/.temp are Supabase CLI state directories.
environments/*/supabase/.branches/
environments/*/supabase/.temp/
environments/*/supabase/migrations/
environments/*/supabase/seed.sql
environments/*/supabase/tests/

# restore-verify is a fully generated, disposable workdir created by
# scripts/supabase-restore.ts for backup-restore drills; nothing under
# it is hand-authored.
environments/restore-verify/

# gen-types is a fully generated, disposable workdir created by
# scripts/supabase-gen-types.ts to generate lib/supabase/database.types.ts
# from the committed migrations alone (Issue #45).
environments/gen-types/

# policy-catalog is a fully generated, disposable workdir created by
# scripts/supabase-policy-catalog.ts to generate
# docs/references/rls-policy-catalog.md from the committed migrations
# alone (Issue #57).
environments/policy-catalog/

# Cloudflare Workers / D1 spike (Issue #116): .open-next and .wrangler are
# build outputs regenerated by `opennextjs-cloudflare build` / `wrangler dev`
# (.wrangler/state/v3/d1にMiniflareのローカルD1状態も含む)。
# worker-configuration.d.ts is regenerated by `npx wrangler types`
# (このスパイクではDOM libとの型衝突を避けるため生成・使用しない方針。
# docs/spikes/cloudflare-workers-d1.md参照)。
# .dev.vars holds local-only secrets for wrangler.
.open-next/
.wrangler/
worker-configuration.d.ts
.dev.vars
.dev.vars.*
!.dev.vars.example

# Logs and local tooling
*.log
.DS_Store
Thumbs.db
.claude/settings.local.json
.claude/worktrees/
